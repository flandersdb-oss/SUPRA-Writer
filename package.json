{
  "name": "supra-writer",
  "version": "0.6.0-alpha.1",
  "private": true,
  "description": "SUPRA Writer Windows alpha with visual outcome setup; SUPRA Office Sheets and Present experimental browser prototypes",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:syntax": "node --check app.js && node --check pwa.js && node --check sw.js && node --check quick-actions.js && node --check office/writer-assistant.js && node --check office/sheets/app.js && node --check office/present/app.js && node --check office/history.js",
    "start:windows": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "test:desktop": "node --test tests/desktop.test.mjs",
    "test:icons": "node --test tests/branding.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "main": "desktop/main.cjs",
  "author": "flandersdb-oss",
  "build": {
    "appId": "org.flandersdb.supra.writer",
    "productName": "SUPRA Writer",
    "copyright": "Copyright © 2026 flandersdb-oss",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "index.html",
      "app.js",
      "pwa.js",
      "quick-actions.js",
      "styles.css",
      "manifest.webmanifest",
      "sw.js",
      "icons/**/*",
      "LICENSE",
      "package.json",
      "office/writer-assistant.js",
      "office/writer-assistant.css"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SUPRA-Writer-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SUPRA Writer"
    },
    "portable": {
      "artifactName": "SUPRA-Writer-Portable-${version}-${arch}.${ext}"
    }
  }
}
